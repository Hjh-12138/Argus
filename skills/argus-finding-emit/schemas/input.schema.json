{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FindingEmitInput",
  "type": "object",
  "required": [
    "agent",
    "category",
    "severity",
    "confidence",
    "title",
    "detail",
    "remediation",
    "verification",
    "fingerprint",
    "rule_id",
    "rule_version",
    "evidence"
  ],
  "properties": {
    "agent": {
      "type": "string",
      "enum": [
        "dep",
        "arch",
        "code",
        "sec",
        "perf",
        "robust",
        "delivery",
        "atk"
      ]
    },
    "category": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "title": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    },
    "file": {
      "type": [
        "string",
        "null"
      ]
    },
    "line_start": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "line_end": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "remediation": {
      "type": "string"
    },
    "verification": {
      "type": "string"
    },
    "fingerprint": {
      "type": "string"
    },
    "rule_id": {
      "type": "string"
    },
    "rule_version": {
      "type": "string"
    },
    "evidence": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
